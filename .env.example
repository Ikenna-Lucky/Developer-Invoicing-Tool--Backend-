# ─── Database (Neon.tech PostgreSQL) ────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Generate strong secrets with: openssl rand -hex 64
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── Paystack (Payment links — test mode) ────────────────────────────────────
# Get your test keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
# Webhook secret: in Paystack dashboard → Settings → API Keys & Webhooks
# Add your server URL: https://yourdomain.com/webhooks/paystack
# Paystack re-uses PAYSTACK_SECRET_KEY to sign webhook events (no separate secret needed)

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Emails are sent from this address. Use onboarding@resend.dev for dev/testing.
EMAIL_FROM=onboarding@resend.dev

# ─── Resend API key ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxx
# Generate with: openssl rand -hex 32. Keep stable while emails are queued.
EMAIL_QUEUE_ENCRYPTION_KEY=replace_with_64_hexadecimal_characters

# ─── Cloudinary (File Storage) ───────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ─── Google OAuth ────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI to add: http://localhost:3001/auth/google/callback
# Optional: leave both Google values empty to disable OAuth.
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
# In production, set both URLs explicitly to HTTPS origins (no paths/query/fragment).
# Default: use the socket IP. Set only after verifying your ingress proxy chain.
RATE_LIMIT_PROXY_HOPS=0
NODE_ENV=development

# Optional backend error tracking. Leave empty to use structured logs only.
SENTRY_DSN=

# Operator-only recovery tools; these do not enable a backup schedule.
# Use direct Neon URLs with pooling disabled. Keep the backup key separately.
BACKUP_DATABASE_URL=
BACKUP_ENCRYPTION_KEY=
RESTORE_DATABASE_URL=
RESTORE_CONFIRM_DATABASE=

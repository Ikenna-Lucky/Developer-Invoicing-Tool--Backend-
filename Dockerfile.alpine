# Evaluation candidate; Render continues to use Dockerfile.
FROM oven/bun:1.4.5-alpine

# Keep this evaluation on Alpine 3.24's stable repositories.
RUN test "$(cut -d. -f1,2 /etc/alpine-release)" = "3.24" \
    && apk upgrade --no-cache \
    && apk add --no-cache ca-certificates chromium font-liberation \
    && bun --version \
    && chromium --version

ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

WORKDIR /app
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile
COPY . .

EXPOSE 3001
CMD ["bun", "scripts/start.ts"]
